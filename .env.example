# Copie para .env e preencha com os valores reais (peça o arquivo local de credenciais).
# O .env NÃO é versionado (ver .gitignore). Ver docs/technical/seguranca.md §44.

# APPLICATION
APP_ENV=development
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
# Chave de cifragem de dados sensíveis em repouso (libsodium). Gere com:
#   php -r "echo base64_encode(random_bytes(32));"
# Trocar a chave torna ilegíveis as credenciais já cifradas no banco.
APP_KEY=

# MYSQL
DATABASE_HOST=
DATABASE_PORT=25060
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=true

# GEMINI  (ver docs/integrations/gemini.md)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# NANO BANANA / imagem  (ver docs/integrations/images.md)
# IMAGE_API_KEY vazio => usa GEMINI_API_KEY (mesma conta Google hoje).
IMAGE_API_KEY=
IMAGE_MODEL=gemini-3-pro-image-preview
IMAGE_API_REVISION=2026-05-20
IMAGE_DEFAULT_SIZE=1K
# Quantas variações da imagem destacada gerar para o Redator-Chefe escolher.
IMAGE_FEATURED_OPTIONS=3

# WORDPRESS
# As credenciais do WordPress são específicas de cada site (tabela site_wordpress_connections),
# não entram aqui como credencial global. Ver docs/technical/seguranca.md §46.

# GOOGLE LOGIN (Login com Google — opcional, complementar ao e-mail+senha)
# Client ID OAuth 2.0 (tipo "Web application") do Google Cloud Console.
# NÃO é um segredo — fica embutido no HTML da tela de login (data-client_id).
# Sem client secret: o fluxo só verifica o ID token (verifyIdToken), nunca
# troca authorization code no servidor. Ver docs/technical/seguranca.md §48.
GOOGLE_CLIENT_ID=

# FILA / REDIS
# QUEUE_DRIVER=sync (padrão, roda inline) ou redis (fila de verdade, consumida por bin/worker.php — ADR-006).
QUEUE_DRIVER=sync
# Formato: redis://[:senha@]host:porta[/db]. Exemplo local: redis://127.0.0.1:6379
# Obrigatória quando QUEUE_DRIVER=redis. Ver docs/technical/setup-e-operacoes.md §77 para subir um Redis local.
REDIS_URL=

