{
    "name": "pixelads/editorial-dashboard",
    "description": "COMPOST — plataforma interna de gestão editorial com IA (PHP puro, sem framework).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "google/apiclient": "^2.18",
        "predis/predis": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "css": "tools/tailwindcss -i src/styles/input.css -o public/assets/css/app.css --minify",
        "css:watch": "tools/tailwindcss -i src/styles/input.css -o public/assets/css/app.css --watch",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    }
}
